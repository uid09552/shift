# ---- Builder Stage ----
FROM python:3.14-slim-bookworm AS builder

WORKDIR /app

# Install uv for fast dependency management. Pinned: an unpinned uv changed
# which interpreter it picks from one build to the next, and older versions
# preferred a *downloaded* CPython over the one this image ships.
RUN pip install --no-cache-dir uv==0.12.17

# Copy project files
COPY planner/pyproject.toml planner/uv.lock* planner/README.md ./
COPY planner/shift_planner ./shift_planner

# Install dependencies against this image's own Python. Without pinning the
# interpreter, uv may fetch a managed CPython instead, and the whole thing —
# including the unpatched setuptools it bundles — is copied into the runtime
# stage with the venv, where Trivy rightly flags it (GHSA-6v7p-g79w-8964,
# CVE-2025-47273). UV_PYTHON_DOWNLOADS=never turns a miss into a build failure
# rather than a silent second interpreter.
ENV UV_PYTHON_DOWNLOADS=never
RUN uv sync --frozen --no-dev --python /usr/local/bin/python3

# ---- Runtime Stage ----
FROM python:3.14-slim-bookworm

WORKDIR /app

# Copy virtual environment from builder
COPY --from=builder /app/.venv /app/.venv

# Copy application code
COPY planner/shift_planner ./shift_planner

# Ensure the virtual environment is in PATH
ENV PATH="/app/.venv/bin:$PATH"

# Build information, passed by GitLab CI (see .gitlab-ci.yml); the health
# endpoint reports it. Unset, the package version is reported.
ARG APP_VERSION=""
ARG GIT_COMMIT=""
ARG BUILD_DATE=""
ENV APP_VERSION=$APP_VERSION GIT_COMMIT=$GIT_COMMIT BUILD_DATE=$BUILD_DATE


# Run the NATS JetStream subscriber
CMD ["python", "-m", "shift_planner", "nats", "--broker-url", "nats://nats:4222"]
