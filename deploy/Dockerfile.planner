# ---- Builder Stage ----
FROM python:3.12-slim-bookworm AS builder

WORKDIR /app

# Install uv for fast dependency management
RUN pip install uv

# Copy project files
COPY planner/pyproject.toml planner/uv.lock* planner/README.md ./
COPY planner/shift_planner ./shift_planner

# Install dependencies
RUN uv sync --frozen --no-dev

# ---- Runtime Stage ----
FROM python:3.12-slim-bookworm

WORKDIR /app

# Copy virtual environment from builder
COPY --from=builder /app/.venv /app/.venv

# Copy application code
COPY planner/shift_planner ./shift_planner

# Ensure the virtual environment is in PATH
ENV PATH="/app/.venv/bin:$PATH"

# Build information, passed by GitLab CI (see .gitlab-ci.yml); the health
# endpoint reports it. Unset, the package version is reported.
ARG APP_VERSION=""
ARG GIT_COMMIT=""
ARG BUILD_DATE=""
ENV APP_VERSION=$APP_VERSION GIT_COMMIT=$GIT_COMMIT BUILD_DATE=$BUILD_DATE


# Run the NATS JetStream subscriber
CMD ["python", "-m", "shift_planner", "nats", "--broker-url", "nats://nats:4222"]
