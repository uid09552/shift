# ---- Builder Stage ----
FROM python:3.14-slim-bookworm AS builder

WORKDIR /app

# Install uv for fast dependency management
RUN pip install uv

# Copy project files
COPY agent/pyproject.toml agent/uv.lock* agent/README.md ./
COPY agent/shift_agent ./shift_agent

# Install dependencies
RUN uv sync --frozen --no-dev

# ---- Runtime Stage ----
FROM python:3.14-slim-bookworm

WORKDIR /app

# Copy virtual environment from builder
COPY --from=builder /app/.venv /app/.venv

# Copy application code
COPY agent/shift_agent ./shift_agent

# The MCP server exposes the Rust backend's OpenAPI spec as tools; it resolves
# the spec path as three directories up from shift_agent/mcp/server.py, which
# inside this image is the filesystem root (see OPENAPI_SPEC_PATH).
COPY api/openapi.yaml /api/openapi.yaml

# The Open Knowledge Format documentation bundle the chat agent answers product,
# architecture and how-to questions from (shift_agent/agent/knowledge.py). Same
# path trick as the spec above: config.py's default resolves two levels up from
# shift_agent/config.py, i.e. the image root. Override with
# SHIFT_AGENT_KNOWLEDGE_PATH or `shift-agent api --knowledge-path`.
COPY docs/knowledge /docs/knowledge

# Ensure the virtual environment is in PATH
ENV PATH="/app/.venv/bin:$PATH"

# Build information, passed by GitLab CI (see .gitlab-ci.yml); the health
# endpoint reports it. Unset, the package version is reported.
ARG APP_VERSION=""
ARG GIT_COMMIT=""
ARG BUILD_DATE=""
ENV APP_VERSION=$APP_VERSION GIT_COMMIT=$GIT_COMMIT BUILD_DATE=$BUILD_DATE

# Expose the REST API port (shift-agent api) and MCP HTTP port. Each
# container built from this image runs exactly one of the two — the
# "agent" and "mcp" services in docker-compose.yml override CMD.
EXPOSE 8899
EXPOSE 8900

# Default: REST API server. The mcp service overrides this command.
CMD ["shift-agent", "api", "--host", "0.0.0.0", "--port", "8899"]
