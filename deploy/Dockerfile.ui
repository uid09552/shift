# Stage 1: Build the Angular application
FROM node:24-slim AS build

WORKDIR /app

COPY ui/package.json ui/package-lock.json ./
RUN npm ci

COPY ui/ .

# Build information, passed by GitLab CI (see .gitlab-ci.yml) and replaced
# into the bundle as constants — see ui/src/app/shared/build-info.ts. Unset,
# the UI shows "dev".
ARG APP_VERSION=""
ARG GIT_COMMIT=""
ARG BUILD_DATE=""
RUN npm run build -- \
      --define "APP_VERSION='${APP_VERSION}'" \
      --define "GIT_COMMIT='${GIT_COMMIT}'" \
      --define "BUILD_DATE='${BUILD_DATE}'"

# Stage 2: Serve with nginx
FROM nginx:alpine

# Check for Alpine security fixes on every image build, not only when nginx's
# base image changes. BUILD_DATE is passed by both CI pipelines.
ARG BUILD_DATE=""
RUN echo "Refreshing Alpine packages for ${BUILD_DATE:-local build}" \
    && apk upgrade --no-cache

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/ng-tailadmin/browser /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
