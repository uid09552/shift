# =============================================================================
# Shift Agent — Environment Variables (copy to .env and fill in)
# =============================================================================
# Copy this file to deploy/.env and fill in the values before running
# docker-compose up. The agent service reads these automatically.
#
#   cp deploy/.env.example deploy/.env
#   docker-compose up -d
# =============================================================================

# OpenAI API key used by langchain-openai (ChatOpenAI reads this automatically).
OPENAI_API_KEY=

# Base URL of the Rust backend's REST API that the agent's tools call.
# Inside Docker, use the Docker service name "backend".
BACKEND_API_URL=http://backend:8080/api/v1

# Optional: forwarded as the x-access-token header on every backend request.
# Leave unset when the backend runs with --dev-mode (no auth required).
BACKEND_ACCESS_TOKEN=

# Keycloak realm URL for MCP server auth (authorization code + DCR).
# Inside Docker, use the Docker service name "kratos" or the IAM gateway.
KEYCLOAK_REALM_URL=http://kratos:4434/realms/shift

# Base URL of the MCP server (used for OAuth redirect URIs).
MCP_BASE_URL=http://mcp:8900

# Streamable-HTTP endpoint the agent calls to discover and run its tools.
# Inside Docker, use the Docker service name "mcp"; the path is always /mcp.
MCP_SERVER_URL=http://mcp:8900/mcp

# Optional comma-separated allowlist of MCP tools to expose to the model.
# Unset = every backend operation, which is a lot of tools for a small model.
MCP_TOOLS=navigate,listShifts,listWorkstations,listCapabilities,listEmployees,getPlannerSettings,updatePlannerSettings

# OAuth2 client credentials for the MCP server's own auth.
# These must match a confidential Keycloak client with service accounts enabled
# (e.g. shift-gateway — see deploy/iam/realm-shift.json).
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=

# Model + generation settings.
SHIFT_AGENT_MODEL=gpt-4o
SHIFT_AGENT_MAX_TOKENS=4096

# =============================================================================
# Flowise - Low-code LLM app builder
# =============================================================================

# Flowise UI login credentials (default: admin / flowise)
FLOWISE_USERNAME=admin
FLOWISE_PASSWORD=flowise
