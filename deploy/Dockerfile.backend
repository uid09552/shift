# ---- Builder Stage ----
FROM rust:1.88-bookworm AS builder

WORKDIR /app

# Build information, passed by GitLab CI (see .gitlab-ci.yml) and compiled
# into the binary via option_env! — GET /api/v1/info reports it. Unset, the
# binary reports the crate version.
ARG APP_VERSION=""
ARG GIT_COMMIT=""
ARG BUILD_DATE=""
ENV APP_VERSION=$APP_VERSION GIT_COMMIT=$GIT_COMMIT BUILD_DATE=$BUILD_DATE

# Copy all source files
COPY . .

# Build the application in release mode
RUN cargo build --release

# ---- Runtime Stage ----
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the compiled binary from the builder stage
COPY --from=builder /app/target/release/shift ./shift

# Copy config file
COPY config.yaml ./config.yaml

# Expose the application port
EXPOSE 8080

# Run the binary with CLI args to ensure correct Docker networking
# --listen 0.0.0.0 binds to all interfaces so the container is reachable
# --database-url uses the Docker service name "postgres" for DNS resolution
# --broker-host uses the Docker service name "nats" for DNS resolution
CMD ["./shift", "serve", "--listen", "0.0.0.0", "--database-url", "postgresql://postgres:postgres@postgres:5432/shift", "--broker-host", "nats", "--optimizer-url", "http://planner:5000"]
