{
  "realm": "shift",
  "displayName": "Shift Hospital",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "clients": [
    {
      "clientId": "shift-web",
      "name": "Shift Web",
      "description": "Angular SPA — public PKCE client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost/auth/callback",
        "http://localhost:4200/auth/callback"
      ],
      "webOrigins": [
        "http://localhost",
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost/*##http://localhost:4200/*"
      }
    },
    {
      "clientId": "shift-gateway",
      "name": "Shift Gateway",
      "description": "Confidential client for APISIX gateway (authorization code flow)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "shift-gateway-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost/callback"
      ],
      "webOrigins": [
        "http://localhost"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost/*"
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "shift-admin",
        "description": "Hospital administrator"
      },
      {
        "name": "shift-planner",
        "description": "Shift planner / scheduler"
      },
      {
        "name": "shift-viewer",
        "description": "Read-only access to schedules"
      }
    ]
  },
  "users": [
    {
      "username": "admin",
      "email": "admin@shift.local",
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": ["shift-admin", "default-roles-shift"]
    }
  ]
}
