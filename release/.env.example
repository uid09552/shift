# =============================================================================
# Shift Release — docker compose configuration
# =============================================================================
# Copy to .env next to docker-compose.yml:
#
#   cp .env.example .env
#
# This file configures the COMPOSE STACK (which images, which ports, which
# credentials). Runtime settings for the chat agent and MCP server live in
# agent.env — do not mix the two. Keycloak is deployed separately and has its
# own iam/.env.
# =============================================================================

# -----------------------------------------------------------------------------
# Published images (self-built services)
# -----------------------------------------------------------------------------
# All four come from the GitLab container registry of this project:
#   registry.gitlab.com/uid09552/shift/<service>:<tag>
# Pin a released tag instead of :latest for reproducible deployments, e.g.
#   BACKEND_IMAGE=registry.gitlab.com/uid09552/shift/backend:1.4.0
# The "mcp" service intentionally reuses AGENT_IMAGE — same image, different
# command.
BACKEND_IMAGE=registry.gitlab.com/uid09552/shift/backend:latest
PLANNER_IMAGE=registry.gitlab.com/uid09552/shift/planner:latest
UI_IMAGE=registry.gitlab.com/uid09552/shift/ui:latest
AGENT_IMAGE=registry.gitlab.com/uid09552/shift/agent:latest

# -----------------------------------------------------------------------------
# Third-party images (upstream registries — not built by this project)
# -----------------------------------------------------------------------------
POSTGRES_IMAGE=postgres:17-alpine
NATS_IMAGE=nats:2
APISIX_IMAGE=apache/apisix:3.16.0-debian
N8N_IMAGE=n8nio/n8n:latest

# -----------------------------------------------------------------------------
# Networking
# -----------------------------------------------------------------------------
# The stack runs on the external docker networks "backend" and "dev_backend"
# (same as deploy/docker-compose.yml — not configurable). Create them once:
#   docker network create backend
#   docker network create dev_backend
#
# Host ports the APISIX gateway publishes. Everything else stays on those
# networks.
HTTP_PORT=80
HTTPS_PORT=443

# The URL users reach the stack on. Keycloak's issuer must match it
# (PUBLIC_URL in iam/.env), so it must be what the browser actually uses —
# including a non-default HTTP_PORT, e.g. http://localhost:8080.
#
# NOTE: the gateway's own OIDC redirect_uri values are literals in
# gateway/apisix_conf/apisix-standalone.yaml. If you change PUBLIC_URL away
# from http://localhost, update the redirect_uri / post_logout_redirect_uri
# fields in that file to match.
PUBLIC_URL=http://localhost

# -----------------------------------------------------------------------------
# Application database (backend)
# -----------------------------------------------------------------------------
POSTGRES_DB=shift
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres

# -----------------------------------------------------------------------------
# Keycloak — configured in iam/.env, not here
# -----------------------------------------------------------------------------
# Keycloak runs as its own compose project (iam/docker-compose.yml). Nothing in
# this stack consumes its credentials; the gateway only proxies /auth/* to it
# and validates tokens against it. The "shift-gateway" client secret lives in
# three places that must agree:
#   iam/.env                                  MCP_OAUTH_CLIENT_SECRET
#   agent.env                                 MCP_OAUTH_CLIENT_SECRET
#   gateway/apisix_conf/apisix-standalone.yaml   client_secret: (literal)

# -----------------------------------------------------------------------------
# Optional tooling (docker compose --profile tools up -d)
# -----------------------------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_ENCRYPTION_KEY=change-me-please
