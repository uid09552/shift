# =============================================================================
# Shift IAM — Keycloak configuration
# =============================================================================
# Copy to .env next to iam/docker-compose.yml:
#
#   cp .env.example .env
#
# Separate from the main stack's ../.env because Keycloak is deployed on its
# own. Two values MUST be kept in sync across both:
#   PUBLIC_URL                — same as in ../.env
#   MCP_OAUTH_CLIENT_SECRET   — same as in ../agent.env, and as the literal
#                               client_secret in
#                               ../gateway/apisix_conf/apisix-standalone.yaml
# =============================================================================

# -----------------------------------------------------------------------------
# Images
# -----------------------------------------------------------------------------
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.2
POSTGRES_IMAGE=postgres:17-alpine

# -----------------------------------------------------------------------------
# Networking
# -----------------------------------------------------------------------------
# Keycloak joins the same external networks as the application stack
# ("backend" / "dev_backend") and must be resolvable there as "keycloak" — the
# upstream name used by the gateway. Create them once:
#   docker network create backend
#   docker network create dev_backend
#
# How browsers reach the stack. Becomes Keycloak's issuer (KC_HOSTNAME =
# ${PUBLIC_URL}/auth) and the base of the realm's redirect URIs, so it must be
# identical to PUBLIC_URL in ../.env.
PUBLIC_URL=http://localhost

# Host port for direct admin-console access, bypassing the gateway.
KEYCLOAK_HTTP_PORT=8080

# -----------------------------------------------------------------------------
# Credentials
# -----------------------------------------------------------------------------
# Keycloak's own database.
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db

# Master-realm admin (admin console at ${PUBLIC_URL}/auth/admin/).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin

# Initial user created in the "shift" realm by the realm import.
KEYCLOAK_REALM_ADMIN_USER=admin
KEYCLOAK_REALM_ADMIN_PASSWORD=change-me-shift-admin

# Secret of the "shift-gateway" confidential client, substituted into the
# realm import on first start.
MCP_OAUTH_CLIENT_SECRET=shift-gateway-secret

KEYCLOAK_LOG_LEVEL=info
