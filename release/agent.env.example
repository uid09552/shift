# =============================================================================
# Shift Agent + MCP server — runtime configuration
# =============================================================================
# Copy to agent.env next to docker-compose.yml:
#
#   cp agent.env.example agent.env
#
# This file is loaded via env_file into the "agent" and "mcp" services only.
# It is deliberately NOT called .env: that name belongs to the compose file's
# own variables (images, ports, credentials — see .env.example).
#
# Hostnames below are docker-compose service names on the internal "shift"
# network, so they work unchanged inside the stack.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM provider
# -----------------------------------------------------------------------------
# One of: openai | ollama | ollama-com
SHIFT_AGENT_LLM_PROVIDER=openai

# Model name — provider-specific:
#   openai:     e.g. gpt-4o, gpt-4o-mini
#   ollama:     e.g. llama3.2, qwen2.5, mistral, gpt-oss:20b
#   ollama-com: e.g. llama3.2-70b, qwen2.5-72b-instruct
SHIFT_AGENT_MODEL=gpt-4o

SHIFT_AGENT_MAX_TOKENS=4096
SHIFT_AGENT_TEMPERATURE=0.1

# OpenAI API key — required when SHIFT_AGENT_LLM_PROVIDER=openai.
OPENAI_API_KEY=

# Ollama (self-hosted) — used when SHIFT_AGENT_LLM_PROVIDER=ollama.
# Point this at a reachable Ollama server; if it runs on the docker host, use
# http://host.docker.internal:11434 and add an extra_hosts entry for the
# agent/mcp services.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Ollama.com (cloud) — used when SHIFT_AGENT_LLM_PROVIDER=ollama-com.
# Get a key at https://ollama.com/settings/keys
OLLAMA_COM_API_KEY=
OLLAMA_COM_BASE_URL=https://ollama.com

# -----------------------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------------------
# REST API of the Rust backend that the MCP tools call.
BACKEND_API_URL=http://backend:8080/api/v1

# Optional: forwarded as the x-access-token header on every backend request.
# Leave empty in the normal setup — the agent forwards the signed-in user's
# access token per request instead.
BACKEND_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# MCP server
# -----------------------------------------------------------------------------
# Streamable-HTTP endpoint the agent uses to discover and run its tools.
# Overridden in docker-compose.yml to the "mcp" service; set here for
# standalone runs of the agent outside compose.
MCP_SERVER_URL=http://mcp:8900/mcp

# Base URL of the MCP server (used to build OAuth redirect URIs).
MCP_BASE_URL=http://mcp:8900

# Timeout for a single MCP tool call, in seconds.
MCP_TIMEOUT_SECONDS=60

# Comma-separated allowlist of MCP tools exposed to the model. Leave unset to
# expose every backend operation — that is a lot of tools for a small model.
# The default below is the curated working set: employees (incl. capabilities
# and available shifts), shifts, capabilities, workstations, unavailabilities,
# planning (prepare/status/settings/tasks/optimized results) and the confirmed
# plans + analysis reads. Deliberately left out: the import/download-template
# operations, audit logs, triggerPlan, and the delete* operations beyond the
# ones listed.
MCP_TOOLS=navigate,listEmployees,createEmployee,updateEmployee,getEmployeeByEmail,getEmployeeCapabilities,addEmployeeCapability,getEmployeeAvailableShifts,addEmployeeAvailableShift,listShifts,createShift,getShiftById,setShiftWeekdayTime,deleteShiftWeekdayTime,listCapabilities,createCapability,listWorkstations,createWorkstation,updateWorkstation,setWorkstationAvailability,enableWorkstation,disableWorkstation,getWorkstationRequiredCapabilities,addWorkstationRequiredCapability,listWorkstationUnavailabilities,createWorkstationUnavailability,deleteWorkstationUnavailability,listUnavailabilities,createUnavailability,getUnavailabilityById,deleteUnavailability,getPlanStatus,preparePlan,getPlannerSettings,updatePlannerSettings,listTasks,getTask,listOptimizedShifts,getOptimizedShift,updateOptimizedShift,takeOptimizedShiftAsPlan,getEmployeeShiftAssignments,createShiftAssignment,listConfirmedShiftPlans,updateConfirmedShiftPlan,getEmployeeConfirmedShiftPlans,getPlannedHoursPerDayPerWorkstation,getPlannedEmployeesPerDayPerWorkstation,optimizeSchedule

# -----------------------------------------------------------------------------
# Knowledge base
# -----------------------------------------------------------------------------
# Root of the documentation bundle (docs/knowledge, Open Knowledge Format) the
# agent answers product, architecture, solver and how-to questions from. It adds
# the searchKnowledge / readKnowledgeDoc / listKnowledgeTopics tools, which
# MCP_TOOLS above does not cover. docker-compose.yml pins this to the in-image
# path the agent image copies the bundle to; set it here only to point the agent
# at a different bundle (e.g. a mounted volume you edit without rebuilding).
# Verify what a running container sees with:
#   docker compose exec agent shift-agent knowledge
# SHIFT_AGENT_KNOWLEDGE_PATH=/docs/knowledge

# -----------------------------------------------------------------------------
# Auth (Keycloak)
# -----------------------------------------------------------------------------
# Realm URL used to validate incoming tokens and for MCP OAuth flows.
KEYCLOAK_REALM_URL=http://keycloak:8080/auth/realms/shift

# JWKS endpoint used to verify the forwarded access tokens.
KEYCLOAK_JWKS_URL=http://keycloak:8080/auth/realms/shift/protocol/openid-connect/certs

# OAuth2 client credentials for the MCP server's own auth. Must match the
# "shift-gateway" confidential client created by the realm import — keep
# MCP_OAUTH_CLIENT_SECRET in sync with the value in .env.
# Note: the "mcp" service blanks both of these in docker-compose.yml (plain
# HTTP); they are used by the "agent" service.
MCP_OAUTH_CLIENT_ID=shift-gateway
MCP_OAUTH_CLIENT_SECRET=shift-gateway-secret
