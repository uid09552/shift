# OpenAI API key used by langchain-openai (ChatOpenAI reads this automatically).
OPENAI_API_KEY=

# Base URL of the Rust backend's REST API that the agent's tools call.
BACKEND_API_URL=http://localhost/api/v1

# Optional: forwarded as the x-access-token header on every backend request.
# Leave unset when the backend runs with --dev-mode (no auth required).
BACKEND_ACCESS_TOKEN=

# mcp_server.py's own auth, for the `shift-agent mcp --transport http` server:
# each connecting MCP client authenticates against Keycloak (authorization
# code + DCR), and its own token is forwarded to the backend on every call —
# see auth.py for the priority order. Only takes effect over HTTP transport,
# and only if both of these are set. Needs a confidential Keycloak client
# with service accounts enabled (e.g. shift-gateway — see
# deploy/iam/realm-shift.json).
KEYCLOAK_REALM_URL=http://localhost/auth/realms/shift
MCP_BASE_URL=http://localhost:8900
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=

# Model + generation settings.
SHIFT_AGENT_MODEL=gpt-4o
SHIFT_AGENT_MAX_TOKENS=4096
