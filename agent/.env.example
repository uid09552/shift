# =============================================================================
# LLM Provider
# =============================================================================
# One of: "ollama" (local), "ollama-com" (ollama.com cloud), "openai"
SHIFT_AGENT_LLM_PROVIDER=ollama

# Model name — provider-specific:
#   ollama:     e.g. llama3.2, qwen2.5, mistral
#   ollama-com: e.g. gpt-oss:20b, gpt-oss:120b, kimi-k2.6 (see your account's
#               available models at https://ollama.com/settings/keys)
#   openai:     e.g. gpt-4o, gpt-4o-mini
SHIFT_AGENT_MODEL=llama3.2

SHIFT_AGENT_MAX_TOKENS=4096
SHIFT_AGENT_TEMPERATURE=0.1

# The model's context window, in tokens — everything sent in one call has to fit:
# the system prompt, the tool definitions, the conversation so far and every tool
# result in it. Once a session outgrows what is left after reserving
# SHIFT_AGENT_MAX_TOKENS for the reply, the oldest turns are dropped before the
# call rather than letting it fail. Set this to your model's real window:
# 131072 suits gpt-oss and llama 3.x; gpt-4o is 128000; smaller local models are
# often 8192 or 32768.
SHIFT_AGENT_MAX_CONTEXT_TOKENS=131072

# IANA timezone the agent answers "today" in — the ward's timezone, which is not
# necessarily the server's. Unset = the host's local time.
# SHIFT_AGENT_TIMEZONE=Europe/Berlin

# =============================================================================
# Ollama (local)
# =============================================================================
# Base URL of the local Ollama server (used when SHIFT_AGENT_LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# Ollama.com (cloud)
# =============================================================================
# API key for ollama.com cloud (used when SHIFT_AGENT_LLM_PROVIDER=ollama-com)
# Get yours at https://ollama.com/settings/keys
OLLAMA_COM_API_KEY=

# ollama.com API base URL (defaults to https://api.ollama.com)
# OLLAMA_COM_BASE_URL=https://api.ollama.com

# =============================================================================
# OpenAI (fallback)
# =============================================================================
# OpenAI API key used by langchain-openai (ChatOpenAI reads this automatically).
# Only needed when SHIFT_AGENT_LLM_PROVIDER=openai
OPENAI_API_KEY=

# =============================================================================
# Backend API
# =============================================================================
# Base URL of the Rust backend's REST API that the agent's tools call.
BACKEND_API_URL=http://localhost/api/v1

# Optional: forwarded as the x-access-token header on every backend request.
# Leave unset when the backend runs with --dev-mode (no auth required).
BACKEND_ACCESS_TOKEN=

# =============================================================================
# Keycloak / Auth (for the chat REST API — shift_agent/agent/server.py)
# =============================================================================
# Keycloak realm URL. Used to derive the JWKS endpoint for token verification.
KEYCLOAK_REALM_URL=http://localhost/auth/realms/shift

# Explicit JWKS URL (overrides the derived one from KEYCLOAK_REALM_URL).
# When set, POST /api/v1/chat requires Authorization: Bearer <token>.
# Leave unset for dev mode (no auth).
# KEYCLOAK_JWKS_URL=http://localhost/auth/realms/shift/protocol/openid-connect/certs

# =============================================================================
# MCP server (the agent's tools — shift_agent/agent/client.py)
# =============================================================================
# Streamable-HTTP endpoint of the MCP server the agent discovers and calls its
# tools on. Defaults to the "mcp" service in deploy/docker-compose.yml; running
# the agent outside Docker, point it at your local `make mcp-http`.
# MCP_SERVER_URL=http://localhost:8900/mcp
MCP_SERVER_URL=http://mcp:8900/mcp

# How long a single MCP call may take, in seconds.
MCP_TIMEOUT_SECONDS=30

# The same, for the tools that run a solve rather than a query
# (optimizeSchedule — see LONG_RUNNING_TOOLS in agent/client.py). It has to
# exceed the solver's own solver_time_limit_seconds, default 120.
MCP_LONG_TIMEOUT_SECONDS=300

# Optional comma-separated allowlist of MCP tool names to bind to the model.
# Unset = every tool the server exposes, i.e. the whole backend API — usually
# more than a small local model can pick from reliably.
# getStaffingPerDay is what answers "how many people work today" and "who is on
# the night shift"; drop it and the agent cannot answer either.
MCP_TOOLS=navigate,listShifts,listWorkstations,listCapabilities,listEmployees,getStaffingPerDay,listConfirmedShiftPlans,getPlannerSettings,updatePlannerSettings,listOptimizedShifts,optimizeSchedule

# =============================================================================
# Optimizer (the CP-SAT service — planner/shift_planner/server.py)
# =============================================================================
# REST API of the optimizer, behind the MCP server's `optimizeSchedule` tool
# and the repair step of POST /api/v1/plan/fix. This is the one service the MCP
# server calls directly instead of through the Rust API, because a solve has to
# be waited on and /planner/plan only queues one. Defaults to the "planner-api"
# service in deploy/docker-compose.yml; running outside Docker, point it at
# your local `cd planner && make api`.
# OPTIMIZER_URL=http://localhost:8888
OPTIMIZER_URL=http://planner-api:8888

# How long to wait for a solve, in seconds. The solver's own time limit
# (planner settings, default 120s) has to fit inside this with room to spare.
OPTIMIZER_TIMEOUT_SECONDS=300

# =============================================================================
# Knowledge base (the agent's own tools — shift_agent/agent/knowledge.py)
# =============================================================================
# Root of the Open Knowledge Format documentation bundle the agent answers
# product, architecture, solver and how-to questions from. It adds the
# searchKnowledge / readKnowledgeDoc / listKnowledgeTopics tools, which are
# NOT affected by MCP_TOOLS above (that allowlist only covers MCP tools).
#
# Defaults to backend/docs/knowledge relative to the package, which inside
# deploy/Dockerfile.agent resolves to /docs/knowledge. Set it when running the
# agent from somewhere else, or point it at your own bundle. A path that does
# not exist just disables the three tools.
# Overridable at startup: shift-agent api --knowledge-path /docs/knowledge
# SHIFT_AGENT_KNOWLEDGE_PATH=/docs/knowledge

# The MCP server's own incoming-client auth, for `shift-agent mcp --transport
# http` (shift_agent/mcp/server.py): each connecting MCP client authenticates
# against Keycloak (authorization code + DCR), and its own token is forwarded
# to the backend on every call — see shift_agent/mcp/auth.py. Only takes effect
# over HTTP transport, and only if both of these are set. Needs a confidential
# Keycloak client with service accounts enabled (e.g. shift-gateway — see
# deploy/iam/realm-shift.json).
MCP_BASE_URL=http://localhost:8900
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
